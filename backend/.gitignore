# =============================================================================
# SEVAK Backend Git Ignore
# =============================================================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Temporary data / logs
*.log
tmp/
uploads/
