# ============================================================
# SEVAK - Gnani AI Configuration
# ============================================================

# Required for Gnani Prisma v2.5 STT and Timbre v2.5 TTS
GNANI_API_KEY=""

# Gnani Prisma v2.5 Speech-to-Text
GNANI_PRISMA_ENDPOINT="https://api.vachana.ai/stt/v3"

# Gnani Timbre v2.5 Text-to-Speech
GNANI_TIMBRE_ENDPOINT="https://api.vachana.ai/api/v1/tts/inference"

# ============================================================
# Evon v3.3
# ============================================================

# Hugging Face token - leave blank until HF access is configured
HF_TOKEN=""

# Leave blank unless you have a dedicated/hosted Evon endpoint
HF_EVON_ENDPOINT=""

# Official Evon v3.3 model ID
HF_MODEL_ID="gnani/gnani-evon-v3.3-30B-A3B"

# ============================================================
# Application
# ============================================================

MAX_FILE_SIZE_MB=10

CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
