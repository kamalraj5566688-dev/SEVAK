# =============================================================================
# SEVAK Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env in your root and backend/ directories.
# All values are optional: SEVAK automatically boots into safe demo fallback mode
# when credentials are omitted, so you can explore the entire flow out-of-the-box!
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GITHUB.
# =============================================================================

# 1. Gnani AI Credentials (Prisma STT & Timbre TTS)
# Obtain your developer token from the Gnani.ai portal: https://gnani.ai
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_PRISMA_ENDPOINT="https://api.gnani.ai/v1/stt"
GNANI_TIMBRE_ENDPOINT="https://api.gnani.ai/v1/tts"

# 2. Hugging Face Evon-30B Indic Legal Reasoning Engine
# Obtain your token from https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_huggingface_token_here"

# Option A: Dedicated Inference Endpoint URL (Recommended for production)
HF_EVON_ENDPOINT=""

# Option B: Serverless / Router Model ID on Hugging Face
HF_MODEL_ID="gnani/gnani-evon-v3.3-30B-A3B"

# 3. Frontend & Server Settings
VITE_API_BASE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
MAX_FILE_SIZE_MB="10"
APP_NAME="SEVAK Backend"
APP_VERSION="1.0.0"

# 4. API Authentication (C-01)
# Set SEVAK_API_KEY to a strong secret in production. When empty, auth is disabled (demo mode).
SEVAK_API_KEY=""
API_KEY_REQUIRED="false"

# Frontend API key (Vite only exposes VITE_* variables to client code)
VITE_SEVAK_API_KEY=""
